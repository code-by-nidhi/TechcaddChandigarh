# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials. Restart `npm run dev` after changing anything here.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=techcadd

# Set to true only when MySQL is reached over the internet (PlanetScale, RDS,
# Aiven). Leave false for localhost or same-server hosting.
MYSQL_SSL=false

# Connection pool size. Keep it small on shared hosting, which caps concurrent
# connections per account.
MYSQL_POOL_SIZE=5

# --------------------------------------------------------------------------
# CMS (cms-techcadd/backend)
# --------------------------------------------------------------------------

# Where the CMS API is reachable from this server. Leave it unset and the site
# renders entirely from the static content in `data/` — which is what a fresh
# clone does, with no services to start. Set it and blog posts, FAQs, reviews
# and the site settings come from the CMS instead, with the static content
# still standing in whenever the API cannot be reached.
#
# No trailing slash, and no `/api` — the client appends `/api/public` itself.
CMS_API_URL=http://localhost:4000

# How long, in seconds, a page may serve CMS content before checking again.
# This is the backstop: with the webhook below configured, a publish shows up
# immediately and this only matters if that call is missed.
CMS_REVALIDATE_SECONDS=300

# Shared secret for POST /api/revalidate, which the CMS calls after every
# successful save so a published change appears without waiting out the window
# above. Must match REVALIDATE_SECRET in the CMS's own .env, and the CMS must
# point SITE_REVALIDATE_URL at this site's /api/revalidate. Leave it unset and
# the endpoint refuses every request rather than letting anyone clear the cache.
REVALIDATE_SECRET=
